generator client {
  provider     = "prisma-client"
  output       = "../../../packages/prisma-client/src/generated"
  moduleFormat = "esm"
}

enum ItemType {
  PRODUCT
  SERVICE
}

enum ItemUnit {
  PCS
  NOS
  KG
  G
  LTR
  ML
  MTR
  BOX
  PACK
  SET
  HOUR
  DAY
  SERVICE
}

enum StockMovementType {
  OPENING
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  INVOICE_FINALIZED
  INVOICE_CANCELLED
  PURCHASE_BILL_FINALIZED
  PURCHASE_BILL_CANCELLED
  SALES_RETURN_FINALIZED
  SALES_RETURN_CANCELLED
  PURCHASE_RETURN_FINALIZED
  PURCHASE_RETURN_CANCELLED
}

enum InvoiceStatus {
  DRAFT
  FINALIZED
  CANCELLED
}

enum InvoiceSalesChannel {
  STANDARD
  POS
}

enum InvoicePriceMode {
  EXCLUSIVE
  INCLUSIVE
}

enum LineDiscountType {
  NONE
  PERCENT
  AMOUNT
}

enum BusinessDocumentType {
  QUOTATION
  SALES_ORDER
  DELIVERY_CHALLAN
  SALES_RETURN
  PURCHASE_ORDER
  PURCHASE_BILL
  PURCHASE_RETURN
}

enum BusinessDocumentStatus {
  DRAFT
  ISSUED
  ACCEPTED
  REJECTED
  CONFIRMED
  FINALIZED
  CANCELLED
}

enum MoneyAccountType {
  CASH
  BANK
  UPI
  OTHER
}

enum AccountEntryType {
  OPENING_BALANCE
  CUSTOMER_RECEIPT
  SUPPLIER_PAYMENT
  EXPENSE
  TRANSFER_IN
  TRANSFER_OUT
  PAYMENT_REVERSAL
  EXPENSE_REVERSAL
  TRANSFER_REVERSAL
}

enum AccountEntryDirection {
  CREDIT
  DEBIT
}

enum PaymentType {
  CUSTOMER_RECEIPT
  SUPPLIER_PAYMENT
}

enum PaymentStatus {
  DRAFT
  POSTED
  REVERSED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  UPI
  CARD
  CHEQUE
  OTHER
}

enum FinanceSequenceType {
  CUSTOMER_RECEIPT
  SUPPLIER_PAYMENT
  EXPENSE
  TRANSFER
}

enum ExpenseStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum TransferStatus {
  POSTED
  REVERSED
}

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  businessId  String    @db.Uuid
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  name        String    @db.VarChar(120)
  nameKey     String    @db.VarChar(120)
  description String?   @db.VarChar(1000)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@unique([id, businessId])
  @@unique([businessId, nameKey])
  @@index([businessId, isActive, name])
}

model Product {
  id             String                 @id @default(uuid()) @db.Uuid
  businessId     String                 @db.Uuid
  business       Business               @relation(fields: [businessId], references: [id], onDelete: Restrict)
  productCode    String                 @db.VarChar(20)
  type           ItemType
  name           String                 @db.VarChar(160)
  description    String?                @db.VarChar(2000)
  categoryId     String?                @db.Uuid
  category       Category?              @relation(fields: [categoryId, businessId], references: [id, businessId], onDelete: Restrict)
  sku            String?                @db.VarChar(80)
  barcode        String?                @db.VarChar(100)
  hsnSacCode     String?                @db.VarChar(8)
  gstRate        Decimal                @default(0) @db.Decimal(5, 2)
  unit           ItemUnit
  purchasePrice  Decimal                @default(0) @db.Decimal(15, 2)
  salePrice      Decimal                @default(0) @db.Decimal(15, 2)
  mrp            Decimal?               @db.Decimal(15, 2)
  trackInventory Boolean                @default(false)
  openingStock   Decimal                @default(0) @db.Decimal(18, 3)
  currentStock   Decimal                @default(0) @db.Decimal(18, 3)
  minimumStock   Decimal?               @db.Decimal(18, 3)
  isActive       Boolean                @default(true)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  movements      StockMovement[]
  invoiceLines   InvoiceLine[]
  documentLines  BusinessDocumentLine[]

  @@unique([id, businessId])
  @@unique([businessId, productCode])
  @@unique([businessId, sku])
  @@unique([businessId, barcode])
  @@index([businessId, isActive, type])
  @@index([businessId, name])
  @@index([businessId, categoryId])
}

model StockMovement {
  id          String            @id @default(uuid()) @db.Uuid
  businessId  String            @db.Uuid
  business    Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  productId   String            @db.Uuid
  product     Product           @relation(fields: [productId, businessId], references: [id, businessId], onDelete: Restrict)
  type        StockMovementType
  quantity    Decimal           @db.Decimal(18, 3)
  beforeStock Decimal           @db.Decimal(18, 3)
  afterStock  Decimal           @db.Decimal(18, 3)
  reason      String            @db.VarChar(500)
  createdById String            @db.Uuid
  createdBy   User              @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime          @default(now())
  invoiceId   String?           @db.Uuid
  invoice     Invoice?          @relation(fields: [invoiceId, businessId], references: [id, businessId], onDelete: Restrict)
  documentId  String?           @db.Uuid
  document    BusinessDocument? @relation(fields: [documentId, businessId], references: [id, businessId], onDelete: Restrict)

  @@index([businessId, productId, createdAt])
  @@index([businessId, invoiceId])
  @@index([businessId, documentId])
  @@index([createdById])
}

enum CustomerType {
  INDIVIDUAL
  BUSINESS
}

enum BalanceDirection {
  RECEIVABLE
  PAYABLE
}

model Customer {
  id                    String             @id @default(uuid()) @db.Uuid
  businessId            String             @db.Uuid
  business              Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  displayName           String             @db.VarChar(160)
  businessName          String?            @db.VarChar(160)
  contactPerson         String?            @db.VarChar(160)
  gstRegistered         Boolean            @default(false)
  gstin                 String?            @db.VarChar(15)
  pan                   String?            @db.VarChar(10)
  phone                 String             @db.VarChar(16)
  whatsappNumber        String?            @db.VarChar(16)
  email                 String?            @db.VarChar(254)
  addressLine1          String             @db.VarChar(200)
  addressLine2          String?            @db.VarChar(200)
  city                  String             @db.VarChar(80)
  state                 String             @db.VarChar(80)
  stateCode             String             @db.Char(2)
  pincode               String             @db.Char(6)
  openingBalance        Decimal            @default(0) @db.Decimal(15, 2)
  openingBalanceType    BalanceDirection
  paymentTermsDays      Int                @default(0)
  notes                 String?            @db.VarChar(2000)
  isActive              Boolean            @default(true)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  customerCode          String             @db.VarChar(20)
  customerType          CustomerType       @default(INDIVIDUAL)
  shippingSameAsBilling Boolean            @default(true)
  shippingAddressLine1  String?            @db.VarChar(200)
  shippingAddressLine2  String?            @db.VarChar(200)
  shippingCity          String?            @db.VarChar(80)
  shippingState         String?            @db.VarChar(80)
  shippingStateCode     String?            @db.Char(2)
  shippingPincode       String?            @db.Char(6)
  creditLimit           Decimal?           @db.Decimal(15, 2)
  invoices              Invoice[]
  businessDocuments     BusinessDocument[]
  payments              Payment[]

  @@unique([id, businessId])
  @@unique([businessId, customerCode])
  @@unique([businessId, gstin])
  @@index([businessId, isActive, createdAt])
  @@index([businessId, displayName])
}

model Supplier {
  id                 String             @id @default(uuid()) @db.Uuid
  businessId         String             @db.Uuid
  business           Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  displayName        String             @db.VarChar(160)
  businessName       String?            @db.VarChar(160)
  contactPerson      String?            @db.VarChar(160)
  gstRegistered      Boolean            @default(false)
  gstin              String?            @db.VarChar(15)
  pan                String?            @db.VarChar(10)
  phone              String             @db.VarChar(16)
  whatsappNumber     String?            @db.VarChar(16)
  email              String?            @db.VarChar(254)
  addressLine1       String             @db.VarChar(200)
  addressLine2       String?            @db.VarChar(200)
  city               String             @db.VarChar(80)
  state              String             @db.VarChar(80)
  stateCode          String             @db.Char(2)
  pincode            String             @db.Char(6)
  openingBalance     Decimal            @default(0) @db.Decimal(15, 2)
  openingBalanceType BalanceDirection
  paymentTermsDays   Int                @default(0)
  notes              String?            @db.VarChar(2000)
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  supplierCode       String             @db.VarChar(20)
  bankName           String?            @db.VarChar(120)
  accountHolderName  String?            @db.VarChar(160)
  accountNumber      String?            @db.VarChar(34)
  ifsc               String?            @db.Char(11)
  upiId              String?            @db.VarChar(100)
  businessDocuments  BusinessDocument[]
  payments           Payment[]
  expenses           Expense[]

  @@unique([id, businessId])
  @@unique([businessId, supplierCode])
  @@unique([businessId, gstin])
  @@index([businessId, isActive, createdAt])
  @@index([businessId, displayName])
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum BusinessRole {
  OWNER
  MEMBER
}

enum BusinessType {
  PROPRIETORSHIP
  PARTNERSHIP
  LLP
  PRIVATE_LIMITED
  OTHER
}

enum GstMode {
  EXCLUSIVE
  INCLUSIVE
  NOT_APPLICABLE
}

model User {
  stockMovements           StockMovement[]
  createdInvoices          Invoice[]                @relation("CreatedInvoices")
  finalizedInvoices        Invoice[]                @relation("FinalizedInvoices")
  cancelledInvoices        Invoice[]                @relation("CancelledInvoices")
  createdMoneyAccounts     MoneyAccount[]           @relation("CreatedMoneyAccounts")
  accountEntries           MoneyAccountEntry[]      @relation("CreatedAccountEntries")
  createdPayments          Payment[]                @relation("CreatedPayments")
  postedPayments           Payment[]                @relation("PostedPayments")
  reversedPayments         Payment[]                @relation("ReversedPayments")
  createdExpenseCategories ExpenseCategory[]        @relation("CreatedExpenseCategories")
  createdExpenses          Expense[]                @relation("CreatedExpenses")
  postedExpenses           Expense[]                @relation("PostedExpenses")
  cancelledExpenses        Expense[]                @relation("CancelledExpenses")
  createdTransfers         AccountTransfer[]        @relation("CreatedTransfers")
  reversedTransfers        AccountTransfer[]        @relation("ReversedTransfers")
  id                       String                   @id @default(uuid()) @db.Uuid
  email                    String                   @unique @db.VarChar(254)
  mobile                   String?                  @db.VarChar(16)
  passwordHash             String
  firstName                String                   @db.VarChar(80)
  lastName                 String                   @db.VarChar(80)
  emailVerifiedAt          DateTime?
  status                   UserStatus               @default(ACTIVE)
  authVersion              Int                      @default(0)
  currentBusinessId        String?                  @db.Uuid
  currentBusiness          Business?                @relation("CurrentBusiness", fields: [currentBusinessId], references: [id], onDelete: SetNull)
  memberships              BusinessMember[]
  sessions                 AuthSession[]
  passwordResetTokens      PasswordResetToken[]
  emailVerificationTokens  EmailVerificationToken[]
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt

  @@index([currentBusinessId])
}

model AuthSession {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String         @db.Uuid
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  authVersion Int
  expiresAt   DateTime
  revokedAt   DateTime?
  tokens      RefreshToken[]
  createdAt   DateTime       @default(now())

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model RefreshToken {
  id        String      @id @default(uuid()) @db.Uuid
  sessionId String      @db.Uuid
  session   AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tokenHash String      @unique @db.Char(64)
  usedAt    DateTime?
  createdAt DateTime    @default(now())

  @@index([sessionId])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// Only NestJS accesses tenant data. Future financial operations require
// transactions and business-scoped queries/indexes, designed in their phases.
model Business {
  categories            Category[]
  products              Product[]
  stockMovements        StockMovement[]
  invoices              Invoice[]
  invoiceSequences      InvoiceSequence[]
  businessDocuments     BusinessDocument[]
  documentSequences     BusinessDocumentSequence[]
  moneyAccounts         MoneyAccount[]
  accountEntries        MoneyAccountEntry[]
  financeSequences      FinanceSequence[]
  payments              Payment[]
  paymentAllocations    PaymentAllocation[]
  expenseCategories     ExpenseCategory[]
  expenses              Expense[]
  accountTransfers      AccountTransfer[]
  nextProductNumber     Int                        @default(0)
  nextAccountNumber     Int                        @default(0)
  customers             Customer[]
  suppliers             Supplier[]
  nextCustomerNumber    Int                        @default(0)
  nextSupplierNumber    Int                        @default(0)
  id                    String                     @id @default(uuid()) @db.Uuid
  name                  String                     @db.VarChar(160)
  tradeName             String?                    @db.VarChar(160)
  ownerName             String                     @db.VarChar(160)
  businessType          BusinessType
  gstRegistered         Boolean
  gstin                 String?                    @unique @db.VarChar(15)
  pan                   String?                    @db.VarChar(10)
  mobile                String                     @db.VarChar(16)
  email                 String                     @db.VarChar(254)
  addressLine1          String                     @db.VarChar(200)
  addressLine2          String?                    @db.VarChar(200)
  state                 String                     @db.VarChar(80)
  stateCode             String                     @db.Char(2)
  city                  String                     @db.VarChar(80)
  pincode               String                     @db.Char(6)
  logoReference         String?                    @db.VarChar(250)
  invoicePrefix         String                     @db.VarChar(12)
  financialYear         String                     @db.Char(7)
  gstMode               GstMode
  bankName              String?                    @db.VarChar(120)
  accountHolder         String?                    @db.VarChar(160)
  accountNumber         String?                    @db.VarChar(34)
  ifsc                  String?                    @db.Char(11)
  upiId                 String?                    @db.VarChar(100)
  onboardingCompletedAt DateTime
  memberships           BusinessMember[]
  currentUsers          User[]                     @relation("CurrentBusiness")
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
}

model InvoiceSequence {
  id            String   @id @default(uuid()) @db.Uuid
  businessId    String   @db.Uuid
  business      Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  financialYear String   @db.Char(7)
  nextNumber    Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([businessId, financialYear])
}

model Invoice {
  id                     String              @id @default(uuid()) @db.Uuid
  businessId             String              @db.Uuid
  business               Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  status                 InvoiceStatus       @default(DRAFT)
  salesChannel           InvoiceSalesChannel @default(STANDARD)
  posClientCheckoutId    String?             @db.Uuid
  invoiceNumber          String?             @db.VarChar(40)
  sequenceNumber         Int?
  financialYear          String              @db.Char(7)
  invoiceDate            DateTime            @db.Date
  dueDate                DateTime?           @db.Date
  customerId             String?             @db.Uuid
  customer               Customer?           @relation(fields: [customerId, businessId], references: [id, businessId], onDelete: Restrict)
  placeOfSupplyState     String              @db.VarChar(80)
  placeOfSupplyStateCode String              @db.Char(2)
  gstApplicable          Boolean             @default(false)
  priceMode              InvoicePriceMode    @default(EXCLUSIVE)
  notes                  String?             @db.VarChar(2000)
  terms                  String?             @db.VarChar(2000)
  sellerBusinessName     String              @db.VarChar(160)
  sellerLegalName        String?             @db.VarChar(160)
  sellerGstin            String?             @db.VarChar(15)
  sellerPan              String?             @db.VarChar(10)
  sellerAddressLine1     String              @db.VarChar(200)
  sellerAddressLine2     String?             @db.VarChar(200)
  sellerCity             String              @db.VarChar(80)
  sellerState            String              @db.VarChar(80)
  sellerStateCode        String              @db.Char(2)
  sellerPincode          String              @db.Char(6)
  sellerBankName         String?             @db.VarChar(120)
  sellerAccountHolder    String?             @db.VarChar(160)
  sellerAccountNumber    String?             @db.VarChar(34)
  sellerIfsc             String?             @db.Char(11)
  sellerUpiId            String?             @db.VarChar(100)
  customerCodeSnapshot   String?             @db.VarChar(20)
  customerNameSnapshot   String              @db.VarChar(160)
  customerBusinessName   String?             @db.VarChar(160)
  customerGstinSnapshot  String?             @db.VarChar(15)
  customerPanSnapshot    String?             @db.VarChar(10)
  customerPhoneSnapshot  String?             @db.VarChar(16)
  customerEmailSnapshot  String?             @db.VarChar(254)
  billingAddressLine1    String              @db.VarChar(200)
  billingAddressLine2    String?             @db.VarChar(200)
  billingCity            String              @db.VarChar(80)
  billingState           String              @db.VarChar(80)
  billingStateCode       String              @db.Char(2)
  billingPincode         String              @db.Char(6)
  shippingAddressLine1   String?             @db.VarChar(200)
  shippingAddressLine2   String?             @db.VarChar(200)
  shippingCity           String?             @db.VarChar(80)
  shippingState          String?             @db.VarChar(80)
  shippingStateCode      String?             @db.Char(2)
  shippingPincode        String?             @db.VarChar(6)
  subtotal               Decimal             @default(0) @db.Decimal(15, 2)
  discountTotal          Decimal             @default(0) @db.Decimal(15, 2)
  taxableTotal           Decimal             @default(0) @db.Decimal(15, 2)
  cgstTotal              Decimal             @default(0) @db.Decimal(15, 2)
  sgstTotal              Decimal             @default(0) @db.Decimal(15, 2)
  igstTotal              Decimal             @default(0) @db.Decimal(15, 2)
  taxTotal               Decimal             @default(0) @db.Decimal(15, 2)
  roundOff               Decimal             @default(0) @db.Decimal(15, 2)
  grandTotal             Decimal             @default(0) @db.Decimal(15, 2)
  finalizedAt            DateTime?
  finalizedById          String?             @db.Uuid
  finalizedBy            User?               @relation("FinalizedInvoices", fields: [finalizedById], references: [id], onDelete: Restrict)
  cancelledAt            DateTime?
  cancelledById          String?             @db.Uuid
  cancelledBy            User?               @relation("CancelledInvoices", fields: [cancelledById], references: [id], onDelete: Restrict)
  cancellationReason     String?             @db.VarChar(500)
  createdById            String              @db.Uuid
  createdBy              User                @relation("CreatedInvoices", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  lines                  InvoiceLine[]
  stockMovements         StockMovement[]
  paymentAllocations     PaymentAllocation[]

  @@unique([id, businessId])
  @@unique([businessId, invoiceNumber])
  @@unique([businessId, posClientCheckoutId])
  @@index([businessId, status, invoiceDate])
  @@index([businessId, salesChannel, status, invoiceDate])
  @@index([businessId, customerId])
  @@index([createdById])
  @@index([finalizedById])
  @@index([cancelledById])
}

model InvoiceLine {
  id                  String           @id @default(uuid()) @db.Uuid
  invoiceId           String           @db.Uuid
  businessId          String           @db.Uuid
  invoice             Invoice          @relation(fields: [invoiceId, businessId], references: [id, businessId], onDelete: Cascade)
  productId           String?          @db.Uuid
  product             Product?         @relation(fields: [productId, businessId], references: [id, businessId], onDelete: Restrict)
  lineNumber          Int
  productCodeSnapshot String?          @db.VarChar(20)
  productNameSnapshot String           @db.VarChar(160)
  productTypeSnapshot ItemType
  hsnSacCodeSnapshot  String?          @db.VarChar(8)
  unitSnapshot        ItemUnit
  quantity            Decimal          @db.Decimal(18, 3)
  unitPrice           Decimal          @db.Decimal(15, 2)
  priceMode           InvoicePriceMode
  discountType        LineDiscountType @default(NONE)
  discountValue       Decimal          @default(0) @db.Decimal(15, 2)
  discountAmount      Decimal          @default(0) @db.Decimal(15, 2)
  grossAmount         Decimal          @default(0) @db.Decimal(15, 2)
  taxableAmount       Decimal          @default(0) @db.Decimal(15, 2)
  gstRate             Decimal          @default(0) @db.Decimal(5, 2)
  cgstRate            Decimal          @default(0) @db.Decimal(5, 2)
  cgstAmount          Decimal          @default(0) @db.Decimal(15, 2)
  sgstRate            Decimal          @default(0) @db.Decimal(5, 2)
  sgstAmount          Decimal          @default(0) @db.Decimal(15, 2)
  igstRate            Decimal          @default(0) @db.Decimal(5, 2)
  igstAmount          Decimal          @default(0) @db.Decimal(15, 2)
  taxAmount           Decimal          @default(0) @db.Decimal(15, 2)
  lineTotal           Decimal          @default(0) @db.Decimal(15, 2)
  createdAt           DateTime         @default(now())

  @@unique([invoiceId, lineNumber])
  @@index([businessId, productId])
}

model BusinessMember {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @db.Uuid
  businessId String       @db.Uuid
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  role       BusinessRole @default(MEMBER)
  createdAt  DateTime     @default(now())

  @@unique([userId, businessId])
  @@index([businessId, role])
}

model BusinessDocumentSequence {
  id            String               @id @default(uuid()) @db.Uuid
  businessId    String               @db.Uuid
  business      Business             @relation(fields: [businessId], references: [id], onDelete: Restrict)
  documentType  BusinessDocumentType
  financialYear String               @db.Char(7)
  nextNumber    Int                  @default(0)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@unique([businessId, documentType, financialYear])
}

model BusinessDocument {
  id                     String                 @id @default(uuid()) @db.Uuid
  businessId             String                 @db.Uuid
  business               Business               @relation(fields: [businessId], references: [id], onDelete: Restrict)
  documentType           BusinessDocumentType
  status                 BusinessDocumentStatus @default(DRAFT)
  documentNumber         String?                @db.VarChar(40)
  sequenceNumber         Int?
  financialYear          String                 @db.Char(7)
  documentDate           DateTime               @db.Date
  dueDate                DateTime?              @db.Date
  validUntil             DateTime?              @db.Date
  partyKind              String                 @db.VarChar(10)
  customerId             String?                @db.Uuid
  customer               Customer?              @relation(fields: [customerId, businessId], references: [id, businessId], onDelete: Restrict)
  supplierId             String?                @db.Uuid
  supplier               Supplier?              @relation(fields: [supplierId, businessId], references: [id, businessId], onDelete: Restrict)
  sourceInvoiceId        String?                @db.Uuid
  sourceDocumentId       String?                @db.Uuid
  supplierInvoiceNumber  String?                @db.VarChar(80)
  placeOfSupplyState     String                 @db.VarChar(80)
  placeOfSupplyStateCode String                 @db.Char(2)
  gstApplicable          Boolean                @default(false)
  priceMode              InvoicePriceMode       @default(EXCLUSIVE)
  reason                 String?                @db.VarChar(500)
  notes                  String?                @db.VarChar(2000)
  terms                  String?                @db.VarChar(2000)
  businessNameSnapshot   String                 @db.VarChar(160)
  businessGstinSnapshot  String?                @db.VarChar(15)
  businessAddressLine1   String                 @db.VarChar(200)
  businessCity           String                 @db.VarChar(80)
  businessState          String                 @db.VarChar(80)
  businessStateCode      String                 @db.Char(2)
  businessPincode        String                 @db.VarChar(6)
  partyCodeSnapshot      String?                @db.VarChar(20)
  partyNameSnapshot      String                 @db.VarChar(160)
  partyBusinessName      String?                @db.VarChar(160)
  partyGstinSnapshot     String?                @db.VarChar(15)
  partyPanSnapshot       String?                @db.VarChar(10)
  partyPhoneSnapshot     String?                @db.VarChar(16)
  partyEmailSnapshot     String?                @db.VarChar(254)
  partyAddressLine1      String                 @db.VarChar(200)
  partyCity              String                 @db.VarChar(80)
  partyState             String                 @db.VarChar(80)
  partyStateCode         String                 @db.Char(2)
  partyPincode           String                 @db.VarChar(6)
  subtotal               Decimal                @default(0) @db.Decimal(15, 2)
  discountTotal          Decimal                @default(0) @db.Decimal(15, 2)
  taxableTotal           Decimal                @default(0) @db.Decimal(15, 2)
  cgstTotal              Decimal                @default(0) @db.Decimal(15, 2)
  sgstTotal              Decimal                @default(0) @db.Decimal(15, 2)
  igstTotal              Decimal                @default(0) @db.Decimal(15, 2)
  taxTotal               Decimal                @default(0) @db.Decimal(15, 2)
  roundOff               Decimal                @default(0) @db.Decimal(15, 2)
  grandTotal             Decimal                @default(0) @db.Decimal(15, 2)
  actedAt                DateTime?
  actedById              String?                @db.Uuid
  cancelledAt            DateTime?
  cancelledById          String?                @db.Uuid
  cancellationReason     String?                @db.VarChar(500)
  createdById            String                 @db.Uuid
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  lines                  BusinessDocumentLine[]
  stockMovements         StockMovement[]
  paymentAllocations     PaymentAllocation[]

  @@unique([id, businessId])
  @@unique([businessId, documentNumber])
  @@unique([businessId, supplierId, supplierInvoiceNumber])
  @@index([businessId, documentType, status, documentDate])
  @@index([businessId, customerId])
  @@index([businessId, supplierId])
  @@index([businessId, sourceInvoiceId])
  @@index([businessId, sourceDocumentId])
}

model BusinessDocumentLine {
  id                   String           @id @default(uuid()) @db.Uuid
  documentId           String           @db.Uuid
  businessId           String           @db.Uuid
  document             BusinessDocument @relation(fields: [documentId, businessId], references: [id, businessId], onDelete: Cascade)
  productId            String?          @db.Uuid
  product              Product?         @relation(fields: [productId, businessId], references: [id, businessId], onDelete: Restrict)
  sourceInvoiceLineId  String?          @db.Uuid
  sourceDocumentLineId String?          @db.Uuid
  lineNumber           Int
  productCodeSnapshot  String?          @db.VarChar(20)
  productNameSnapshot  String           @db.VarChar(160)
  productTypeSnapshot  ItemType
  hsnSacCodeSnapshot   String?          @db.VarChar(8)
  unitSnapshot         ItemUnit
  quantity             Decimal          @db.Decimal(18, 3)
  unitPrice            Decimal          @db.Decimal(15, 2)
  priceMode            InvoicePriceMode
  discountType         LineDiscountType @default(NONE)
  discountValue        Decimal          @default(0) @db.Decimal(15, 2)
  discountAmount       Decimal          @default(0) @db.Decimal(15, 2)
  grossAmount          Decimal          @default(0) @db.Decimal(15, 2)
  taxableAmount        Decimal          @default(0) @db.Decimal(15, 2)
  gstRate              Decimal          @default(0) @db.Decimal(5, 2)
  cgstRate             Decimal          @default(0) @db.Decimal(5, 2)
  cgstAmount           Decimal          @default(0) @db.Decimal(15, 2)
  sgstRate             Decimal          @default(0) @db.Decimal(5, 2)
  sgstAmount           Decimal          @default(0) @db.Decimal(15, 2)
  igstRate             Decimal          @default(0) @db.Decimal(5, 2)
  igstAmount           Decimal          @default(0) @db.Decimal(15, 2)
  taxAmount            Decimal          @default(0) @db.Decimal(15, 2)
  lineTotal            Decimal          @default(0) @db.Decimal(15, 2)

  @@index([businessId, productId])
  @@index([businessId, sourceInvoiceLineId])
  @@index([businessId, sourceDocumentLineId])
}

model MoneyAccount {
  id                 String              @id @default(uuid()) @db.Uuid
  businessId         String              @db.Uuid
  business           Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  accountCode        String              @db.VarChar(20)
  name               String              @db.VarChar(120)
  type               MoneyAccountType
  bankName           String?             @db.VarChar(120)
  accountNumberLast4 String?             @db.Char(4)
  ifsc               String?             @db.Char(11)
  upiId              String?             @db.VarChar(100)
  openingBalance     Decimal             @default(0) @db.Decimal(15, 2)
  currentBalance     Decimal             @default(0) @db.Decimal(15, 2)
  isActive           Boolean             @default(true)
  createdById        String              @db.Uuid
  createdBy          User                @relation("CreatedMoneyAccounts", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  entries            MoneyAccountEntry[]
  payments           Payment[]
  expenses           Expense[]
  transfersFrom      AccountTransfer[]   @relation("TransferFromAccount")
  transfersTo        AccountTransfer[]   @relation("TransferToAccount")

  @@unique([id, businessId])
  @@unique([businessId, accountCode])
  @@index([businessId, isActive, type])
  @@index([businessId, name])
}

model MoneyAccountEntry {
  id            String                @id @default(uuid()) @db.Uuid
  businessId    String                @db.Uuid
  business      Business              @relation(fields: [businessId], references: [id], onDelete: Restrict)
  accountId     String                @db.Uuid
  account       MoneyAccount          @relation(fields: [accountId, businessId], references: [id, businessId], onDelete: Restrict)
  type          AccountEntryType
  direction     AccountEntryDirection
  amount        Decimal               @db.Decimal(15, 2)
  balanceBefore Decimal               @db.Decimal(15, 2)
  balanceAfter  Decimal               @db.Decimal(15, 2)
  paymentId     String?               @db.Uuid
  payment       Payment?              @relation(fields: [paymentId, businessId], references: [id, businessId], onDelete: Restrict)
  expenseId     String?               @db.Uuid
  expense       Expense?              @relation(fields: [expenseId, businessId], references: [id, businessId], onDelete: Restrict)
  transferId    String?               @db.Uuid
  transfer      AccountTransfer?      @relation(fields: [transferId, businessId], references: [id, businessId], onDelete: Restrict)
  referenceType String?               @db.VarChar(40)
  referenceId   String?               @db.VarChar(80)
  description   String?               @db.VarChar(500)
  createdById   String                @db.Uuid
  createdBy     User                  @relation("CreatedAccountEntries", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt     DateTime              @default(now())

  @@index([businessId, accountId, createdAt])
  @@index([businessId, paymentId])
  @@index([businessId, expenseId])
  @@index([businessId, transferId])
}

model FinanceSequence {
  id            String              @id @default(uuid()) @db.Uuid
  businessId    String              @db.Uuid
  business      Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  type          FinanceSequenceType
  financialYear String              @db.Char(7)
  nextNumber    Int                 @default(0)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([businessId, type, financialYear])
}

model Payment {
  id              String              @id @default(uuid()) @db.Uuid
  businessId      String              @db.Uuid
  business        Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  paymentNumber   String?             @db.VarChar(40)
  sequenceNumber  Int?
  financialYear   String              @db.Char(7)
  type            PaymentType
  customerId      String?             @db.Uuid
  customer        Customer?           @relation(fields: [customerId, businessId], references: [id, businessId], onDelete: Restrict)
  supplierId      String?             @db.Uuid
  supplier        Supplier?           @relation(fields: [supplierId, businessId], references: [id, businessId], onDelete: Restrict)
  accountId       String              @db.Uuid
  account         MoneyAccount        @relation(fields: [accountId, businessId], references: [id, businessId], onDelete: Restrict)
  paymentDate     DateTime            @db.Date
  method          PaymentMethod
  referenceNumber String?             @db.VarChar(120)
  amount          Decimal             @db.Decimal(15, 2)
  notes           String?             @db.VarChar(2000)
  status          PaymentStatus       @default(DRAFT)
  postedAt        DateTime?
  postedById      String?             @db.Uuid
  postedBy        User?               @relation("PostedPayments", fields: [postedById], references: [id], onDelete: Restrict)
  reversedAt      DateTime?
  reversedById    String?             @db.Uuid
  reversedBy      User?               @relation("ReversedPayments", fields: [reversedById], references: [id], onDelete: Restrict)
  reversalReason  String?             @db.VarChar(500)
  createdById     String              @db.Uuid
  createdBy       User                @relation("CreatedPayments", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  allocations     PaymentAllocation[]
  accountEntries  MoneyAccountEntry[]

  @@unique([id, businessId])
  @@unique([businessId, paymentNumber])
  @@index([businessId, type, status, paymentDate])
  @@index([businessId, customerId])
  @@index([businessId, supplierId])
  @@index([businessId, accountId])
}

model PaymentAllocation {
  id         String            @id @default(uuid()) @db.Uuid
  businessId String            @db.Uuid
  business   Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  paymentId  String            @db.Uuid
  payment    Payment           @relation(fields: [paymentId, businessId], references: [id, businessId], onDelete: Cascade)
  invoiceId  String?           @db.Uuid
  invoice    Invoice?          @relation(fields: [invoiceId, businessId], references: [id, businessId], onDelete: Restrict)
  documentId String?           @db.Uuid
  document   BusinessDocument? @relation(fields: [documentId, businessId], references: [id, businessId], onDelete: Restrict)
  amount     Decimal           @db.Decimal(15, 2)
  createdAt  DateTime          @default(now())

  @@index([businessId, paymentId])
  @@index([businessId, invoiceId])
  @@index([businessId, documentId])
}

model ExpenseCategory {
  id          String    @id @default(uuid()) @db.Uuid
  businessId  String    @db.Uuid
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  name        String    @db.VarChar(120)
  nameKey     String    @db.VarChar(120)
  description String?   @db.VarChar(1000)
  isActive    Boolean   @default(true)
  createdById String    @db.Uuid
  createdBy   User      @relation("CreatedExpenseCategories", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  expenses    Expense[]

  @@unique([id, businessId])
  @@unique([businessId, nameKey])
  @@index([businessId, isActive, name])
}

model Expense {
  id                 String              @id @default(uuid()) @db.Uuid
  businessId         String              @db.Uuid
  business           Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  expenseNumber      String?             @db.VarChar(40)
  sequenceNumber     Int?
  financialYear      String              @db.Char(7)
  categoryId         String              @db.Uuid
  category           ExpenseCategory     @relation(fields: [categoryId, businessId], references: [id, businessId], onDelete: Restrict)
  accountId          String              @db.Uuid
  account            MoneyAccount        @relation(fields: [accountId, businessId], references: [id, businessId], onDelete: Restrict)
  supplierId         String?             @db.Uuid
  supplier           Supplier?           @relation(fields: [supplierId, businessId], references: [id, businessId], onDelete: Restrict)
  expenseDate        DateTime            @db.Date
  description        String              @db.VarChar(500)
  amount             Decimal             @db.Decimal(15, 2)
  method             PaymentMethod
  referenceNumber    String?             @db.VarChar(120)
  notes              String?             @db.VarChar(2000)
  status             ExpenseStatus       @default(DRAFT)
  postedAt           DateTime?
  postedById         String?             @db.Uuid
  postedBy           User?               @relation("PostedExpenses", fields: [postedById], references: [id], onDelete: Restrict)
  cancelledAt        DateTime?
  cancelledById      String?             @db.Uuid
  cancelledBy        User?               @relation("CancelledExpenses", fields: [cancelledById], references: [id], onDelete: Restrict)
  cancellationReason String?             @db.VarChar(500)
  createdById        String              @db.Uuid
  createdBy          User                @relation("CreatedExpenses", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  accountEntries     MoneyAccountEntry[]

  @@unique([id, businessId])
  @@unique([businessId, expenseNumber])
  @@index([businessId, status, expenseDate])
  @@index([businessId, categoryId])
  @@index([businessId, accountId])
  @@index([businessId, supplierId])
}

model AccountTransfer {
  id              String              @id @default(uuid()) @db.Uuid
  businessId      String              @db.Uuid
  business        Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  transferNumber  String              @db.VarChar(40)
  sequenceNumber  Int
  financialYear   String              @db.Char(7)
  fromAccountId   String              @db.Uuid
  fromAccount     MoneyAccount        @relation("TransferFromAccount", fields: [fromAccountId, businessId], references: [id, businessId], onDelete: Restrict)
  toAccountId     String              @db.Uuid
  toAccount       MoneyAccount        @relation("TransferToAccount", fields: [toAccountId, businessId], references: [id, businessId], onDelete: Restrict)
  transferDate    DateTime            @db.Date
  amount          Decimal             @db.Decimal(15, 2)
  referenceNumber String?             @db.VarChar(120)
  notes           String?             @db.VarChar(2000)
  status          TransferStatus      @default(POSTED)
  reversedAt      DateTime?
  reversedById    String?             @db.Uuid
  reversedBy      User?               @relation("ReversedTransfers", fields: [reversedById], references: [id], onDelete: Restrict)
  reversalReason  String?             @db.VarChar(500)
  createdById     String              @db.Uuid
  createdBy       User                @relation("CreatedTransfers", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  accountEntries  MoneyAccountEntry[]

  @@unique([id, businessId])
  @@unique([businessId, transferNumber])
  @@index([businessId, status, transferDate])
  @@index([businessId, fromAccountId])
  @@index([businessId, toAccountId])
}
