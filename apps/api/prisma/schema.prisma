generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

enum ItemType {
  PRODUCT
  SERVICE
}

enum ItemUnit {
  PCS
  NOS
  KG
  G
  LTR
  ML
  MTR
  BOX
  PACK
  SET
  HOUR
  DAY
  SERVICE
}

enum StockMovementType {
  OPENING
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
}

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  businessId  String    @db.Uuid
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  name        String    @db.VarChar(120)
  nameKey     String    @db.VarChar(120)
  description String?   @db.VarChar(1000)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@unique([id, businessId])
  @@unique([businessId, nameKey])
  @@index([businessId, isActive, name])
}

model Product {
  id             String          @id @default(uuid()) @db.Uuid
  businessId     String          @db.Uuid
  business       Business        @relation(fields: [businessId], references: [id], onDelete: Restrict)
  productCode    String          @db.VarChar(20)
  type           ItemType
  name           String          @db.VarChar(160)
  description    String?         @db.VarChar(2000)
  categoryId     String?         @db.Uuid
  category       Category?       @relation(fields: [categoryId, businessId], references: [id, businessId], onDelete: Restrict)
  sku            String?         @db.VarChar(80)
  barcode        String?         @db.VarChar(100)
  hsnSacCode     String?         @db.VarChar(8)
  gstRate        Decimal         @default(0) @db.Decimal(5, 2)
  unit           ItemUnit
  purchasePrice  Decimal         @default(0) @db.Decimal(15, 2)
  salePrice      Decimal         @default(0) @db.Decimal(15, 2)
  mrp            Decimal?        @db.Decimal(15, 2)
  trackInventory Boolean         @default(false)
  openingStock   Decimal         @default(0) @db.Decimal(18, 3)
  currentStock   Decimal         @default(0) @db.Decimal(18, 3)
  minimumStock   Decimal?        @db.Decimal(18, 3)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  movements      StockMovement[]

  @@unique([id, businessId])
  @@unique([businessId, productCode])
  @@unique([businessId, sku])
  @@unique([businessId, barcode])
  @@index([businessId, isActive, type])
  @@index([businessId, name])
  @@index([businessId, categoryId])
}

model StockMovement {
  id          String            @id @default(uuid()) @db.Uuid
  businessId  String            @db.Uuid
  business    Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  productId   String            @db.Uuid
  product     Product           @relation(fields: [productId, businessId], references: [id, businessId], onDelete: Restrict)
  type        StockMovementType
  quantity    Decimal           @db.Decimal(18, 3)
  beforeStock Decimal           @db.Decimal(18, 3)
  afterStock  Decimal           @db.Decimal(18, 3)
  reason      String            @db.VarChar(500)
  createdById String            @db.Uuid
  createdBy   User              @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime          @default(now())

  @@index([businessId, productId, createdAt])
  @@index([createdById])
}

enum CustomerType {
  INDIVIDUAL
  BUSINESS
}

enum BalanceDirection {
  RECEIVABLE
  PAYABLE
}

model Customer {
  id                    String           @id @default(uuid()) @db.Uuid
  businessId            String           @db.Uuid
  business              Business         @relation(fields: [businessId], references: [id], onDelete: Restrict)
  displayName           String           @db.VarChar(160)
  businessName          String?          @db.VarChar(160)
  contactPerson         String?          @db.VarChar(160)
  gstRegistered         Boolean          @default(false)
  gstin                 String?          @db.VarChar(15)
  pan                   String?          @db.VarChar(10)
  phone                 String           @db.VarChar(16)
  whatsappNumber        String?          @db.VarChar(16)
  email                 String?          @db.VarChar(254)
  addressLine1          String           @db.VarChar(200)
  addressLine2          String?          @db.VarChar(200)
  city                  String           @db.VarChar(80)
  state                 String           @db.VarChar(80)
  stateCode             String           @db.Char(2)
  pincode               String           @db.Char(6)
  openingBalance        Decimal          @default(0) @db.Decimal(15, 2)
  openingBalanceType    BalanceDirection
  paymentTermsDays      Int              @default(0)
  notes                 String?          @db.VarChar(2000)
  isActive              Boolean          @default(true)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  customerCode          String           @db.VarChar(20)
  customerType          CustomerType     @default(INDIVIDUAL)
  shippingSameAsBilling Boolean          @default(true)
  shippingAddressLine1  String?          @db.VarChar(200)
  shippingAddressLine2  String?          @db.VarChar(200)
  shippingCity          String?          @db.VarChar(80)
  shippingState         String?          @db.VarChar(80)
  shippingStateCode     String?          @db.Char(2)
  shippingPincode       String?          @db.Char(6)
  creditLimit           Decimal?         @db.Decimal(15, 2)

  @@unique([businessId, customerCode])
  @@unique([businessId, gstin])
  @@index([businessId, isActive, createdAt])
  @@index([businessId, displayName])
}

model Supplier {
  id                 String           @id @default(uuid()) @db.Uuid
  businessId         String           @db.Uuid
  business           Business         @relation(fields: [businessId], references: [id], onDelete: Restrict)
  displayName        String           @db.VarChar(160)
  businessName       String?          @db.VarChar(160)
  contactPerson      String?          @db.VarChar(160)
  gstRegistered      Boolean          @default(false)
  gstin              String?          @db.VarChar(15)
  pan                String?          @db.VarChar(10)
  phone              String           @db.VarChar(16)
  whatsappNumber     String?          @db.VarChar(16)
  email              String?          @db.VarChar(254)
  addressLine1       String           @db.VarChar(200)
  addressLine2       String?          @db.VarChar(200)
  city               String           @db.VarChar(80)
  state              String           @db.VarChar(80)
  stateCode          String           @db.Char(2)
  pincode            String           @db.Char(6)
  openingBalance     Decimal          @default(0) @db.Decimal(15, 2)
  openingBalanceType BalanceDirection
  paymentTermsDays   Int              @default(0)
  notes              String?          @db.VarChar(2000)
  isActive           Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  supplierCode       String           @db.VarChar(20)
  bankName           String?          @db.VarChar(120)
  accountHolderName  String?          @db.VarChar(160)
  accountNumber      String?          @db.VarChar(34)
  ifsc               String?          @db.Char(11)
  upiId              String?          @db.VarChar(100)

  @@unique([businessId, supplierCode])
  @@unique([businessId, gstin])
  @@index([businessId, isActive, createdAt])
  @@index([businessId, displayName])
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum BusinessRole {
  OWNER
  MEMBER
}

enum BusinessType {
  PROPRIETORSHIP
  PARTNERSHIP
  LLP
  PRIVATE_LIMITED
  OTHER
}

enum GstMode {
  EXCLUSIVE
  INCLUSIVE
  NOT_APPLICABLE
}

model User {
  stockMovements          StockMovement[]
  id                      String                   @id @default(uuid()) @db.Uuid
  email                   String                   @unique @db.VarChar(254)
  mobile                  String?                  @db.VarChar(16)
  passwordHash            String
  firstName               String                   @db.VarChar(80)
  lastName                String                   @db.VarChar(80)
  emailVerifiedAt         DateTime?
  status                  UserStatus               @default(ACTIVE)
  authVersion             Int                      @default(0)
  currentBusinessId       String?                  @db.Uuid
  currentBusiness         Business?                @relation("CurrentBusiness", fields: [currentBusinessId], references: [id], onDelete: SetNull)
  memberships             BusinessMember[]
  sessions                AuthSession[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  @@index([currentBusinessId])
}

model AuthSession {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String         @db.Uuid
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  authVersion Int
  expiresAt   DateTime
  revokedAt   DateTime?
  tokens      RefreshToken[]
  createdAt   DateTime       @default(now())

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model RefreshToken {
  id        String      @id @default(uuid()) @db.Uuid
  sessionId String      @db.Uuid
  session   AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tokenHash String      @unique @db.Char(64)
  usedAt    DateTime?
  createdAt DateTime    @default(now())

  @@index([sessionId])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// Only NestJS accesses tenant data. Future financial operations require
// transactions and business-scoped queries/indexes, designed in their phases.
model Business {
  categories            Category[]
  products              Product[]
  stockMovements        StockMovement[]
  nextProductNumber     Int              @default(0)
  customers             Customer[]
  suppliers             Supplier[]
  nextCustomerNumber    Int              @default(0)
  nextSupplierNumber    Int              @default(0)
  id                    String           @id @default(uuid()) @db.Uuid
  name                  String           @db.VarChar(160)
  tradeName             String?          @db.VarChar(160)
  ownerName             String           @db.VarChar(160)
  businessType          BusinessType
  gstRegistered         Boolean
  gstin                 String?          @unique @db.VarChar(15)
  pan                   String?          @db.VarChar(10)
  mobile                String           @db.VarChar(16)
  email                 String           @db.VarChar(254)
  addressLine1          String           @db.VarChar(200)
  addressLine2          String?          @db.VarChar(200)
  state                 String           @db.VarChar(80)
  stateCode             String           @db.Char(2)
  city                  String           @db.VarChar(80)
  pincode               String           @db.Char(6)
  logoReference         String?          @db.VarChar(250)
  invoicePrefix         String           @db.VarChar(12)
  financialYear         String           @db.Char(7)
  gstMode               GstMode
  bankName              String?          @db.VarChar(120)
  accountHolder         String?          @db.VarChar(160)
  accountNumber         String?          @db.VarChar(34)
  ifsc                  String?          @db.Char(11)
  upiId                 String?          @db.VarChar(100)
  onboardingCompletedAt DateTime
  memberships           BusinessMember[]
  currentUsers          User[]           @relation("CurrentBusiness")
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
}

model BusinessMember {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @db.Uuid
  businessId String       @db.Uuid
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  role       BusinessRole @default(MEMBER)
  createdAt  DateTime     @default(now())

  @@unique([userId, businessId])
  @@index([businessId, role])
}
