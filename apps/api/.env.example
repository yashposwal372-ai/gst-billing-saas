NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
# Development-only credentials matching compose.yaml.
DATABASE_URL=postgresql://gst_dev:gst_dev_local@localhost:5432/gst_billing
REDIS_URL=redis://localhost:6379
# Access JWT signing key: use a random value of at least 32 characters.
# Blank only in development/test: uses an ephemeral process key.
# Production requires explicit strong keys. Never commit real secrets.
JWT_SECRET=
# Reserved configuration; opaque refresh tokens use random bytes + SHA-256,
# not a refresh JWT. Retained for compatibility with production config validation.
JWT_REFRESH_SECRET=

PARTY_SERVICE_BASE_URL=http://127.0.0.1:4200
PARTY_SERVICE_TIMEOUT_MS=10000
PARTY_SERVICE_HMAC_SECRET=replace-with-at-least-32-byte-random-secret
