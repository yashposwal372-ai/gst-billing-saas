# Docker Compose local development only. Match apps/api/.env if changed.
POSTGRES_USER=gst_dev
POSTGRES_PASSWORD=gst_dev_local
POSTGRES_DB=gst_billing
POSTGRES_PORT=5432
REDIS_PORT=6379

# API Gateway (A05 parallel strangler entry point)
GATEWAY_PORT=4100
MONOLITH_BASE_URL=http://127.0.0.1:4000
PROXY_TIMEOUT_MS=30000

# A06 internal identity propagation. Use real secrets only in private environment config.
# JWT_SECRET is shared with apps/api only for current symmetric HS256 access-token verification.
JWT_SECRET=replace-with-same-local-api-jwt-secret
INTERNAL_IDENTITY_HMAC_SECRET=replace-with-at-least-32-byte-random-secret
INTERNAL_IDENTITY_MAX_AGE_MS=60000
