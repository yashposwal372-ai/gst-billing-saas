{
  "name": "gst-billing-saas",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "typecheck": "turbo run typecheck",
    "architecture:check": "npm run architecture:check --workspace api",
    "openapi:generate": "npm run openapi:generate --workspace api",
    "openapi:check": "npm run openapi:check --workspace api",
    "gateway:dev": "npm run start:dev --workspace api-gateway",
    "gateway:build": "npm run build --workspace api-gateway",
    "gateway:test": "npm run test --workspace api-gateway",
    "gateway:check": "npm run check --workspace api-gateway",
    "security-context:test": "npm run test --workspace @gst/security-context",
    "party-service:dev": "npm run start:dev --workspace party-service",
    "party-service:build": "npm run build --workspace party-service",
    "party-service:test": "npm run test --workspace party-service",
    "party-service:check": "npm run check --workspace party-service",
    "prisma:prepare": "npm run prisma:generate --workspace api && npm run build --workspace @gst/prisma-client"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.10.12",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "\u003e=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.17.0"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
